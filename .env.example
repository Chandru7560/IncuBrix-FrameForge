# Copy to .env for local Docker Compose development. Replace development
# passwords before exposing any service outside a trusted local machine.
APP_ENV=development
LOG_LEVEL=INFO
MOCK_PROVIDER=true
WORKER_ENABLED=true
WORKER_POLL_SECONDS=0.2
MAX_UPLOAD_BYTES=26214400
MAX_AUDIO_SECONDS=600
MAX_SCENES=100
MAX_REQUEST_BYTES=27262976
INPUT_DIRECTORY=./data/inputs
DATABASE_URL=sqlite:///./data/scenepilot.db
STORAGE_HEALTH_URL=
ALLOWED_AUDIO_HOSTS=
URL_FETCH_TIMEOUT_SECONDS=15
URL_FETCH_MAX_REDIRECTS=3
IDEMPOTENCY_KEY_MAX_LENGTH=128
SPEECH_RECOGNITION_PROVIDER=mock
TTS_PROVIDER=mock
FFPROBE_BINARY=ffprobe
FFMPEG_BINARY=ffmpeg
MIN_SCENE_SECONDS=1.5
MAX_SCENE_SECONDS=12
NARRATION_BOUNDARY_TOLERANCE_SECONDS=0.05
SILENCE_THRESHOLD_DBFS=-55
MOCK_TTS_WORDS_PER_MINUTE=150

# Stock footage adapters are optional. They remain disabled without API keys.
# Rights approval is an explicit operator attestation; without it assets are rejected.
FOOTAGE_SOURCE_ORDER=pexels,pixabay,local
PEXELS_API_KEY=
PIXABAY_API_KEY=
PEXELS_RIGHTS_POLICY_APPROVED=false
PIXABAY_RIGHTS_POLICY_APPROVED=false
FOOTAGE_MIN_RELEVANCE_SCORE=0.35
FOOTAGE_ASPECT_TOLERANCE=0.35
FOOTAGE_WEIGHT_SEMANTIC=0.35
FOOTAGE_WEIGHT_ACTION=0.15
FOOTAGE_WEIGHT_SUBJECT=0.15
FOOTAGE_WEIGHT_COMPOSITION=0.10
FOOTAGE_WEIGHT_SHOT_VARIETY=0.10
FOOTAGE_WEIGHT_TECHNICAL=0.15
MAX_FOOTAGE_CANDIDATES_PER_SOURCE=10
MAX_FOOTAGE_ASSET_BYTES=104857600
FOOTAGE_DOWNLOAD_TIMEOUT_SECONDS=30
FOOTAGE_DIRECTORY=./data/inputs/footage

# Local defaults create honest scene plans without pretending mock narration is
# usable. Enable rendering only after real narration and cleared footage exist.
RENDER_ENABLED=false
OUTPUT_DIRECTORY=./data/outputs
RENDER_CACHE_DIRECTORY=./data/render-cache
RENDER_TIMEOUT_SECONDS=1800
RENDER_DURATION_TOLERANCE_SECONDS=0.08
RENDER_MAX_SLOWDOWN=1.2

# Optional independent visual-relevance evaluation.
# Uses sampled frames from the selected footage; enabling it sends those frames
# and the scene narration/intent to the configured endpoint.
RELEVANCE_EVALUATOR_PROVIDER=disabled
RELEVANCE_EVALUATOR_BASE_URL=
RELEVANCE_EVALUATOR_MODEL=
RELEVANCE_EVALUATOR_API_KEY=
RELEVANCE_EVALUATOR_TIMEOUT_SECONDS=30

# PostgreSQL and MinIO are used by docker-compose.yml. These values are for
# local development only; use a secret manager in deployed environments.
POSTGRES_DB=scenepilot
POSTGRES_USER=scenepilot
POSTGRES_PASSWORD=local-development-only
MINIO_ROOT_USER=scenepilot-local
MINIO_ROOT_PASSWORD=local-minio-development-only
